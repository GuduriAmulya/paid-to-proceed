# ---- PayPal (sandbox) ----
# Developer Dashboard → Apps & Credentials → Sandbox → your REST app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX
# Optional: webhook id from the same app (subscribe to INVOICING.INVOICE.PAID and PAYMENT.PAYOUTSBATCH.*)
# Webhook URL: https://<your-host>/api/webhooks/paypal   (without it, Paid to Proceed polls PayPal every 20s)
PAYPAL_WEBHOOK_ID=

# Sandbox *personal* accounts (Dashboard → Testing Tools → Sandbox Accounts)
# Invoices are sent to the client account; Payouts go to the subcontractor account.
DEMO_CLIENT_EMAIL=
DEMO_SUBCONTRACTOR_EMAIL=

# ---- Claude ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

PORT=8787
